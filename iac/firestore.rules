rules_version = '2';

// architecture.md §5.2: every read/write already goes through Cloud Run
// using the Admin SDK, which bypasses these rules entirely — this is
// defense-in-depth only, in case a future change accidentally exposes a
// client-side Firestore connection.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
